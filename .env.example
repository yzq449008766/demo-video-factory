# OpenAI-compatible TTS endpoint (e.g. local Qwen3-TTS / Kokoro / OpenAI)
TTS_BASE_URL=http://127.0.0.1:8872/v1
TTS_API_KEY=not-needed
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Optional OpenAI-compatible ASR endpoint for word-level alignment
ASR_BASE_URL=http://127.0.0.1:8871/v1
ASR_API_KEY=not-needed

# Optional ComfyUI endpoint for Wan image-to-video generation
COMFYUI_BASE_URL=http://127.0.0.1:8188
